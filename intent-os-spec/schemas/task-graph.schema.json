{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/task-graph.schema.json",
  "title": "Task Graph (Canonical Dependency Representation v2)",
  "description": "하나의 Plan에 속한 Task들의 방향성 비순환 그래프. Task 의존관계의 단일 정본은 edges이며 entry_tasks/analysis/diff는 계산 가능한 derived projection이다.",
  "type": "object",
  "required": ["graph_id", "plan_id", "version", "nodes", "edges", "status"],
  "properties": {
    "graph_id": {"type": "string", "description": "Task Graph 고유 식별자.", "x-ownership": "AUTHORITATIVE"},
    "plan_id": {"type": "string", "description": "이 Graph가 속한 Plan ID.", "x-ownership": "REFERENCE"},
    "version": {"type": "integer", "minimum": 1, "description": "Graph 버전.", "x-ownership": "AUTHORITATIVE"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "이 Graph에 속한 Task ID 참조 집합. Task 본문은 포함하지 않는다.",
      "x-ownership": "REFERENCE"
    },
    "edges": {
      "type": "array",
      "description": "Task 실행 의존관계의 단일 정본. from이 완료되어야 to를 시작할 수 있다.",
      "x-ownership": "AUTHORITATIVE",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "description": "선행 Task ID."},
          "to": {"type": "string", "description": "후행 Task ID."},
          "redundant": {"type": "boolean", "default": false, "description": "전이적 축약상 불필요하지만 명시적으로 유지한 간선 여부."}
        },
        "additionalProperties": false
      }
    },
    "entry_tasks": {
      "type": "array",
      "items": {"type": "string"},
      "readOnly": true,
      "description": "edges에서 계산되는 진입 차수 0 Task 목록.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "#/properties/edges"
    },
    "analysis": {
      "type": "object",
      "readOnly": true,
      "description": "Graph 구조와 Task 추정치에서 계산되는 분석 projection.",
      "x-ownership": "DERIVED",
      "properties": {
        "critical_path": {"type": "array", "items": {"type": "string"}, "description": "임계 경로 Task ID 목록."},
        "estimated_duration": {"type": "string", "description": "계산된 전체 예상 기간(ISO 8601 duration)."},
        "max_parallelism": {"type": "integer", "minimum": 1, "description": "계산된 최대 병렬 실행 수."},
        "spof": {"type": "array", "items": {"type": "string"}, "description": "계산된 단일 실패점 Task 목록."}
      },
      "additionalProperties": false
    },
    "derived_from": {
      "type": ["string", "null"],
      "description": "이 Graph를 인스턴스화한 Workflow 버전 참조.",
      "x-ownership": "REFERENCE"
    },
    "previous_version": {
      "type": ["string", "null"],
      "description": "재계획 이전 Task Graph 버전 참조.",
      "x-ownership": "REFERENCE"
    },
    "diff": {
      "type": ["object", "null"],
      "readOnly": true,
      "description": "previous_version과 현재 Graph를 비교해 계산한 Graph Diff.",
      "x-ownership": "DERIVED",
      "properties": {
        "preserved": {"type": "array", "items": {"type": "string"}, "description": "재사용되는 Task 목록."},
        "invalidated": {"type": "array", "items": {"type": "string"}, "description": "재실행이 필요한 Task 목록."},
        "removed": {"type": "array", "items": {"type": "string"}, "description": "새 Graph에서 제외된 Task 목록."},
        "added": {"type": "array", "items": {"type": "string"}, "description": "새 Graph에 추가된 Task 목록."}
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["Constructed", "Validated", "Active", "Suspended", "Superseded", "Completed"],
      "description": "Task Graph의 현재 상태.",
      "x-ownership": "AUTHORITATIVE"
    }
  },
  "additionalProperties": false
}
