{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/resource.schema.json",
  "title": "Resource (Canonical Identity Representation v2)",
  "description": "Capability를 제공하는 실행 주체의 정체성·선언 정보. 실제 관측 성능/비용/가용성의 정본은 Resource Profile이며, 이 스키마의 observed/performance 필드는 legacy read-only projection으로만 유지한다.",
  "type": "object",
  "required": ["id", "name", "type", "capabilities"],
  "properties": {
    "id": {"type": "string", "description": "Registry 내 Resource 고유 식별자.", "x-ownership": "AUTHORITATIVE"},
    "name": {"type": "string", "description": "사람이 읽는 Resource 이름.", "x-ownership": "AUTHORITATIVE"},
    "type": {
      "type": "string",
      "enum": ["llm", "image_model", "video_model", "search_engine", "api", "database", "tool", "agent", "human", "hybrid"],
      "description": "Resource 종류.",
      "x-ownership": "AUTHORITATIVE"
    },
    "provider": {"type": "string", "description": "Resource 제공 주체.", "x-ownership": "AUTHORITATIVE"},
    "version": {"type": "string", "description": "Resource 버전. 다른 버전의 성능 이력을 합치지 않는다.", "x-ownership": "AUTHORITATIVE"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "description": "Resource가 제공한다고 선언한 Capability 목록.",
      "x-ownership": "AUTHORITATIVE",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "description": "Capability canonical ID.", "x-ownership": "REFERENCE"},
          "declared_score": {"type": "number", "minimum": 0, "maximum": 100, "description": "공급자/등록자가 선언한 점수.", "x-ownership": "AUTHORITATIVE"},
          "observed_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "readOnly": true,
            "deprecated": true,
            "description": "호환용 관측 점수 projection. 실제 정본은 ResourceProfile.capability_scores.observed_score다.",
            "x-ownership": "DERIVED",
            "x-canonical-source": "resource-profile.schema.json#/properties/capability_scores"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "readOnly": true,
            "deprecated": true,
            "description": "호환용 관측 신뢰도 projection. 실제 정본은 Resource Profile이다.",
            "x-ownership": "DERIVED",
            "x-canonical-source": "resource-profile.schema.json#/properties/capability_scores"
          }
        },
        "additionalProperties": false
      }
    },
    "cost_model": {
      "type": "object",
      "description": "공급자·계약상 선언된 과금 구조. 실제 평균 비용은 Resource Profile이 정본이다.",
      "x-ownership": "AUTHORITATIVE"
    },
    "performance": {
      "type": "object",
      "readOnly": true,
      "deprecated": true,
      "description": "호환용 최신 성능 projection. 실측 성능의 정본은 Resource Profile이다.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "resource-profile.schema.json#/properties/performance",
      "properties": {
        "reliability": {"type": "number", "minimum": 0, "maximum": 1, "description": "호환용 응답 성공률 projection."},
        "latency_ms": {"type": "number", "minimum": 0, "description": "호환용 평균 지연 projection."},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "호환용 실사용 성공률 projection."},
        "drift_detected": {"type": "boolean", "description": "호환용 Drift 상태 projection."},
        "last_observed_at": {"type": "string", "format": "date-time", "description": "호환용 마지막 관찰 시각 projection."}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Resource 자체의 구조적/계약적 제한.",
      "x-ownership": "AUTHORITATIVE"
    },
    "availability": {
      "type": "string",
      "description": "계약·구성상 선언된 가용 조건. 실측 uptime/rate-limit은 Resource Profile이 정본이다.",
      "x-ownership": "AUTHORITATIVE"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["Registered", "Evaluating", "Active", "Optimized", "Deprecated", "Removed"],
      "description": "Registry 안에서의 Resource 상태.",
      "x-ownership": "AUTHORITATIVE"
    }
  },
  "additionalProperties": false
}
