{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/task.schema.json",
  "title": "Task (Canonical Task Representation v2)",
  "description": "Goal 달성을 위한 실행 단위. Task 자체는 Resource를 선택하지 않으며, 의존관계는 TaskGraph.edges가 정본이다. assigned_resource_id/attempts/dependencies는 호환용 derived projection으로만 유지한다.",
  "type": "object",
  "required": ["id", "goal_id", "objective", "required_capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Task의 고유 식별자.",
      "x-ownership": "AUTHORITATIVE"
    },
    "goal_id": {
      "type": "string",
      "description": "이 Task가 기여하는 Goal ID. 고아 Task를 금지한다.",
      "x-ownership": "REFERENCE"
    },
    "objective": {
      "type": "string",
      "description": "무엇을 수행하는가. Resource/Tool 이름은 포함하지 않는다.",
      "x-ownership": "AUTHORITATIVE"
    },
    "task_type": {
      "type": "string",
      "enum": ["Research", "Analysis", "Creation", "Transformation", "Decision", "Communication", "Automation", "Verification"],
      "description": "Task의 기능적 분류.",
      "x-ownership": "AUTHORITATIVE"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "description": "Task 수행에 필요한 Capability 참조. Resource 선택의 입력이 된다.",
      "x-ownership": "REFERENCE",
      "items": {
        "anyOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["capability_id"],
            "properties": {
              "capability_id": {"type": "string", "description": "canonical Capability ID."},
              "min_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"], "description": "최소 요구 숙련도."},
              "weight": {"type": "number", "minimum": 0, "maximum": 1, "description": "매칭 시 상대 중요도."}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "readOnly": true,
      "description": "TaskGraph.edges의 incoming edges에서 계산되는 선행 Task projection.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "task-graph.schema.json#/properties/edges"
    },
    "expected_output": {
      "type": "string",
      "description": "완료 판정 기준이 되는 기대 산출물.",
      "x-ownership": "AUTHORITATIVE"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["sequential", "parallel", "conditional"],
      "description": "형제 Task와의 실행 형태. 실제 순서는 TaskGraph.edges가 결정한다.",
      "x-ownership": "AUTHORITATIVE"
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "readOnly": true,
      "deprecated": true,
      "description": "Task에 적용되는 Constraint의 호환용 projection. 현재 제약 정본은 Constraint Entity다.",
      "x-ownership": "DERIVED"
    },
    "priority": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"],
      "description": "Task 실행 우선순위.",
      "x-ownership": "AUTHORITATIVE"
    },
    "retry_policy": {
      "type": "object",
      "description": "Task 실패 시 처리 정책.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0, "description": "재시도 상한."},
        "on_failure": {"type": "string", "enum": ["retry", "reassign", "decompose", "escalate", "abort"], "description": "실패 시 행동."}
      },
      "additionalProperties": false
    },
    "assigned_resource_id": {
      "type": "string",
      "readOnly": true,
      "description": "최신 유효 ResourceSelection Decision에서 계산되는 Resource projection. 직접 쓰지 않는다.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "decision.schema.json"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true,
      "description": "이 Task를 참조하는 Execution 수에서 계산되는 시도 횟수.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "execution.schema.json"
    },
    "state": {
      "type": "string",
      "enum": ["Pending", "Assigned", "Running", "Completed", "Evaluated", "Failed"],
      "description": "Task의 현재 생명주기 상태.",
      "x-ownership": "AUTHORITATIVE"
    }
  },
  "additionalProperties": false
}
