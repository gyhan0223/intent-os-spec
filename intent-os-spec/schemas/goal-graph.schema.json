{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/goal-graph.schema.json",
  "title": "Goal Graph (Canonical Relationship Representation v2)",
  "description": "Goal 간 관계의 단일 정본. Goal 객체 내부의 parent/children/dependencies/related_goals는 이 그래프에서 계산되는 projection이다. canonical node form은 goal_id 참조이며 embedded Goal은 하위 호환만 허용한다.",
  "type": "object",
  "required": ["graph_id", "nodes", "edges"],
  "properties": {
    "graph_id": {
      "type": "string",
      "description": "Goal Graph의 고유 식별자.",
      "x-ownership": "AUTHORITATIVE"
    },
    "root_goal_id": {
      "type": "string",
      "description": "최상위 Root Goal의 ID.",
      "x-ownership": "REFERENCE"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Graph 노드 집합. 신규 canonical write는 goal_id 문자열만 사용한다. embedded Goal 객체는 legacy compatibility용이다.",
      "x-ownership": "REFERENCE",
      "x-canonical-node-form": "id",
      "items": {
        "anyOf": [
          {"type": "string"},
          {"$ref": "goal.schema.json"}
        ]
      }
    },
    "edges": {
      "type": "array",
      "description": "Goal 간 방향성 관계의 단일 정본. 순환 의존은 허용하지 않는다.",
      "x-ownership": "AUTHORITATIVE",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": {"type": "string", "description": "출발 Goal ID."},
          "to": {"type": "string", "description": "도착 Goal ID."},
          "relationship": {
            "type": "string",
            "enum": ["DEPENDS_ON", "ENABLES", "CONFLICTS_WITH", "REQUIRES", "SUPPORTS", "BLOCKS"],
            "description": "두 Goal 사이 관계 종류."
          },
          "weight": {"type": "number", "description": "관계 강도."},
          "resolution": {"type": ["string", "null"], "description": "CONFLICTS_WITH 관계의 해소 상태/방법. 해당 없으면 null."}
        },
        "additionalProperties": false
      }
    },
    "weights": {
      "type": "object",
      "description": "이 Graph 버전에 적용되는 Goal Score 계산 가중치.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "priority": {"type": "number", "description": "priority 가중치."},
        "impact": {"type": "number", "description": "impact 가중치."},
        "urgency": {"type": "number", "description": "urgency 가중치."},
        "risk": {"type": "number", "description": "risk 가중치."},
        "confidence": {"type": "number", "description": "confidence 가중치."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
