{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/resource-profile.schema.json",
  "title": "Resource Profile (Canonical Observed Performance v2)",
  "description": "하나의 Resource가 실제로 어떻게 수행하는지에 대한 Context별 측정 정본. Resource는 정체성과 선언 정보만 소유하고, observed score·실측 비용·성능·가용성·drift는 이 Profile이 정본이다. snapshot_version으로 Decision 시점 재현이 가능하다.",
  "type": "object",
  "required": ["profile_id", "resource_id", "snapshot_version", "capability_scores", "status"],
  "properties": {
    "profile_id": {"type": "string", "description": "Resource Profile의 고유 식별자.", "x-ownership": "AUTHORITATIVE"},
    "resource_id": {"type": "string", "description": "정체성 정본인 Resource를 가리키는 ID.", "x-ownership": "REFERENCE"},
    "snapshot_version": {"type": "string", "description": "Decision이 동결 참조할 수 있는 Profile snapshot 버전.", "x-ownership": "AUTHORITATIVE", "x-snapshot-boundary": true},
    "updated_at": {"type": "string", "format": "date-time", "description": "현재 Profile materialization이 마지막으로 갱신된 시각.", "x-ownership": "AUTHORITATIVE"},
    "status": {
      "type": "string",
      "enum": ["Initialized", "Calibrating", "Established", "Drifting", "Degraded", "Stale"],
      "description": "Profile의 신뢰/Drift 생명주기 상태.",
      "x-ownership": "AUTHORITATIVE"
    },
    "capability_scores": {
      "type": "array",
      "description": "Capability × Context별 관측 성능 정본.",
      "x-ownership": "AUTHORITATIVE",
      "items": {
        "type": "object",
        "required": ["capability", "context", "confidence"],
        "properties": {
          "capability": {"type": "string", "description": "Capability canonical ID.", "x-ownership": "REFERENCE"},
          "context": {
            "type": "object",
            "description": "이 점수가 성립하는 관측 Context.",
            "properties": {
              "domain": {"type": "string", "description": "관측 도메인. 전역 점수는 global을 명시한다."},
              "language": {"type": "string", "description": "관측 언어."},
              "audience": {"type": "string", "description": "관측 대상 독자/사용자군."},
              "task_type": {"type": "string", "description": "관측 Task 종류."}
            },
            "additionalProperties": false
          },
          "declared_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Resource에서 복사된 선언 점수 snapshot. 선택 근거의 보조 입력.", "x-ownership": "SNAPSHOT"},
          "observed_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Execution/Evaluation 관측으로 계산된 현재 점수 정본.", "x-ownership": "AUTHORITATIVE"},
          "sample_size": {"type": "integer", "minimum": 0, "description": "현재 점수를 뒷받침하는 표본 수.", "x-ownership": "AUTHORITATIVE"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "표본·분산·신선도를 반영한 현재 신뢰도.", "x-ownership": "AUTHORITATIVE"},
          "variance": {"type": ["number", "null"], "minimum": 0, "description": "관측 점수 분산. 표본 부족 시 null.", "x-ownership": "AUTHORITATIVE"},
          "last_observed_at": {"type": ["string", "null"], "format": "date-time", "description": "해당 Capability가 마지막으로 관측된 시각.", "x-ownership": "AUTHORITATIVE"}
        },
        "additionalProperties": false
      }
    },
    "cost_model": {
      "type": "object",
      "description": "선택에 사용하는 현재 비용 모델. 선언 단가 snapshot과 실제 평균 비용을 함께 보존한다.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "unit": {"type": "string", "enum": ["token", "task", "hour", "call", "flat"], "description": "과금 단위."},
        "rates": {"type": "object", "description": "Profile 계산 시 사용한 단가 snapshot.", "x-ownership": "SNAPSHOT"},
        "observed_avg_cost": {
          "type": "object",
          "description": "실행당 관측 평균 비용.",
          "properties": {
            "amount": {"type": "number", "minimum": 0, "description": "평균 금액."},
            "currency": {"type": "string", "description": "통화 코드."},
            "per": {"type": "string", "description": "평균의 기준 단위."}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "description": "이 조직의 실사용 관측 성능 정본.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "latency_ms": {
          "type": "object",
          "description": "관측 지연 분포.",
          "properties": {
            "p50": {"type": "integer", "minimum": 0, "description": "지연 중앙값(ms)."},
            "p95": {"type": "integer", "minimum": 0, "description": "지연 95백분위(ms)."},
            "p99": {"type": "integer", "minimum": 0, "description": "지연 99백분위(ms)."}
          },
          "additionalProperties": false
        },
        "reliability": {"type": "number", "minimum": 0, "maximum": 1, "description": "오류 없이 응답한 비율."},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "Execution이 성공적으로 완주한 비율."},
        "throughput": {"type": "object", "description": "단위 시간당 관측 처리량."}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "description": "실측 가용성의 정본.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "schedule": {"type": "string", "description": "현재 관측/계약상 사용 가능한 시간대."},
        "uptime_30d": {"type": "number", "minimum": 0, "maximum": 1, "description": "최근 30일 가동률."},
        "rate_limit": {"type": "object", "description": "현재 유효 호출 상한."}
      },
      "additionalProperties": false
    },
    "drift": {
      "type": "object",
      "description": "관측 분포에서 계산된 Drift 상태. Profile이 외부에 제공하는 canonical current view다.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "detected": {"type": "boolean", "default": false, "description": "기준선 이탈 감지 여부."},
        "direction": {"type": ["string", "null"], "enum": ["up", "down", null], "description": "이탈 방향."},
        "magnitude": {"type": ["number", "null"], "description": "기준선 대비 이탈 정도."},
        "detected_at": {"type": ["string", "null"], "format": "date-time", "description": "Drift 최초 판정 시각."},
        "windows_deviated": {"type": "integer", "minimum": 0, "default": 0, "description": "연속 이탈 관측 구간 수."}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "description": "선택 시 사용하는 현재 제한 목록. Resource 선언과 관측 결과를 합성한 canonical view.", "x-ownership": "AUTHORITATIVE"},
    "genome_ref": {"type": ["string", "null"], "description": "Resource Genome 참조.", "x-ownership": "REFERENCE"},
    "evidence": {
      "type": "object",
      "description": "현재 Profile을 뒷받침하는 관측 집계 정보.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "execution_count": {"type": "integer", "minimum": 0, "description": "집계에 반영된 Execution 수."},
        "window": {"type": "string", "description": "집계 구간(ISO 8601 duration)."},
        "decay_lambda": {"type": "number", "minimum": 0, "description": "시간 감쇠 계수."}
      },
      "additionalProperties": false
    },
    "visibility": {
      "type": "string",
      "enum": ["internal", "internal_restricted"],
      "default": "internal",
      "description": "Profile 접근 범위.",
      "x-ownership": "AUTHORITATIVE"
    }
  },
  "additionalProperties": false
}
