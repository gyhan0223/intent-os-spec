{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intent-os/goal.schema.json",
  "title": "Goal (Canonical Goal Representation v3)",
  "description": "사용자 또는 지능형 주체가 원하는 미래 상태의 정본. 현재 Constraint/Context/Assumption과 Goal 간 그래프 관계는 별도 Entity가 정본이며, 이 스키마의 중복 필드는 Canonical Data Model v1에 따라 snapshot/derived projection으로만 유지한다.",
  "type": "object",
  "required": ["goal_id", "version", "title", "goal_type", "objective", "status", "metadata"],
  "properties": {
    "goal_id": {
      "type": "string",
      "pattern": "^goal_[0-9A-Za-z]{6,}$",
      "description": "시스템 전역에서 유일한 Goal 식별자.",
      "x-ownership": "AUTHORITATIVE"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Goal 정의의 버전. 의미 있는 정본 필드 변경 시 증가한다.",
      "x-ownership": "AUTHORITATIVE"
    },
    "title": {
      "type": "string",
      "description": "사람이 읽기 위한 Goal의 짧은 이름.",
      "x-ownership": "AUTHORITATIVE"
    },
    "goal_type": {
      "type": "string",
      "enum": ["Outcome", "Optimization", "Learning", "Exploration", "Maintenance", "Creation", "Decision", "Automation"],
      "description": "Goal의 타입.",
      "x-ownership": "AUTHORITATIVE"
    },
    "objective": {
      "type": "object",
      "required": ["description"],
      "description": "무엇을 이루고 싶은가를 표현하는 Goal의 핵심 정본.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "description": {
          "type": "string",
          "description": "원하는 미래 상태의 서술."
        },
        "desired_state": {
          "$ref": "#/$defs/metric",
          "description": "Goal 성공 판정의 주 지표."
        },
        "secondary_metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/metric"},
          "description": "주 지표를 보완하는 보조 성공 지표."
        }
      },
      "additionalProperties": false
    },
    "motivation": {
      "type": "array",
      "items": {"type": "string"},
      "description": "왜 이 Goal을 원하는지에 대한 정본 설명.",
      "x-ownership": "AUTHORITATIVE"
    },
    "constraints": {
      "type": "object",
      "readOnly": true,
      "deprecated": true,
      "description": "Goal 생성/승인 시점 제약의 호환용 snapshot. 현재 제약의 정본은 Constraint Entity다. 신규 쓰기에서는 사용하지 않는다.",
      "x-ownership": "SNAPSHOT",
      "properties": {
        "budget": {
          "type": "object",
          "description": "예산 제약 snapshot.",
          "properties": {
            "max": {"type": "number", "description": "최대 금액."},
            "min": {"type": "number", "description": "최소 금액."},
            "currency": {"type": "string", "description": "ISO 4217 통화 코드."}
          },
          "additionalProperties": false
        },
        "deadline": {"type": "string", "format": "date", "description": "마감일 snapshot."},
        "location": {"type": "array", "items": {"type": "string"}, "description": "지역 제약 snapshot."},
        "legal": {"type": "array", "items": {"type": "string"}, "description": "법적 제약 snapshot."},
        "resource_limits": {
          "type": "array",
          "description": "Resource 한도 snapshot.",
          "items": {
            "type": "object",
            "required": ["resource"],
            "properties": {
              "resource": {"type": "string", "description": "제한 대상 Resource."},
              "limit": {"type": ["number", "string"], "description": "상한값."},
              "unit": {"type": "string", "description": "상한 단위."}
            },
            "additionalProperties": false
          }
        },
        "other": {"type": "array", "items": {"type": "string"}, "description": "기타 제약 snapshot."}
      },
      "additionalProperties": false
    },
    "priority": {
      "type": "object",
      "description": "명시 우선순위와 계산 projection.",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"],
          "description": "사람 또는 정책이 지정한 우선순위 등급.",
          "x-ownership": "AUTHORITATIVE"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "readOnly": true,
          "description": "스케줄링용 정규화 가중치. scoring engine에서 계산된다.",
          "x-ownership": "DERIVED"
        },
        "factors": {
          "type": "object",
          "readOnly": true,
          "description": "Goal Score 계산에 사용된 최신 factor projection.",
          "x-ownership": "DERIVED",
          "properties": {
            "impact": {"type": "number", "description": "영향도 factor."},
            "urgency": {"type": "number", "description": "긴급도 factor."},
            "risk": {"type": "number", "description": "위험 factor."},
            "strategic_alignment": {"type": "number", "description": "상위 목적 정합도 factor."}
          },
          "additionalProperties": false
        },
        "computed_score": {
          "type": ["number", "null"],
          "readOnly": true,
          "description": "GoalGraph weights와 factor로 계산된 점수.",
          "x-ownership": "DERIVED"
        },
        "computed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "readOnly": true,
          "description": "computed_score가 계산된 시각.",
          "x-ownership": "DERIVED"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "readOnly": true,
      "deprecated": true,
      "description": "Goal 구조화 시점의 Context snapshot. 현재 세계 상태의 정본은 Context Entity다.",
      "x-ownership": "SNAPSHOT",
      "properties": {
        "current_state": {"type": "object", "description": "구조화 시점 현재 상태 snapshot."},
        "environment": {"type": "object", "description": "구조화 시점 환경 snapshot."},
        "assumptions": {"type": "array", "items": {"type": "string"}, "description": "호환용 가정 snapshot. 현재 가정 정본은 Assumption Entity다."}
      },
      "additionalProperties": false
    },
    "stakeholders": {
      "type": "array",
      "description": "Goal의 소유·승인·기여·영향 주체.",
      "x-ownership": "AUTHORITATIVE",
      "items": {"$ref": "#/$defs/stakeholder"},
      "contains": {
        "type": "object",
        "properties": {"role": {"const": "Owner"}},
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "parent_goal": {
      "type": ["string", "null"],
      "readOnly": true,
      "description": "GoalGraph.edges에서 계산되는 상위 Goal projection. Root면 null.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "goal-graph.schema.json#/properties/edges"
    },
    "child_goals": {
      "type": "array",
      "items": {"type": "string"},
      "readOnly": true,
      "description": "GoalGraph.edges에서 계산되는 하위 Goal projection.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "goal-graph.schema.json#/properties/edges"
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependencyRelation"},
      "readOnly": true,
      "description": "GoalGraph.edges에서 계산되는 의존관계 projection.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "goal-graph.schema.json#/properties/edges"
    },
    "related_goals": {
      "type": "array",
      "items": {"$ref": "#/$defs/relatedRelation"},
      "readOnly": true,
      "description": "GoalGraph.edges에서 계산되는 비의존 관계 projection.",
      "x-ownership": "DERIVED",
      "x-canonical-source": "goal-graph.schema.json#/properties/edges"
    },
    "status": {
      "type": "object",
      "required": ["phase"],
      "description": "Goal 생명주기 상태.",
      "x-ownership": "AUTHORITATIVE",
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["Created", "Clarified", "Structured", "Executable", "Planning", "Executing", "Monitoring", "Completed", "Failed", "Suspended", "Abandoned", "Archived"],
          "description": "현재 Goal phase."
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "readOnly": true,
          "description": "Goal metric과 Context/Outcome에서 계산되는 진행률.",
          "x-ownership": "DERIVED"
        },
        "entered_at": {"type": "string", "format": "date-time", "description": "현재 phase 진입 시각."},
        "blocked_reason": {"type": ["string", "null"], "description": "Suspended/Failed 상태의 사유."}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "description": "Goal 데이터 품질 정보.",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Goal이 실제 의도를 반영한다는 추론 신뢰도.",
          "x-ownership": "AUTHORITATIVE"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "readOnly": true,
          "description": "Validation Rule에서 계산한 완성도 점수.",
          "x-ownership": "DERIVED"
        },
        "completeness_level": {
          "type": "integer",
          "enum": [1, 2, 3],
          "readOnly": true,
          "description": "Validation Rule에서 계산한 Raw/Structured/Executable 수준.",
          "x-ownership": "DERIVED"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["created_by", "created_at", "source"],
      "description": "Goal의 생성 provenance와 호환용 변경 projection.",
      "properties": {
        "created_by": {"type": "string", "description": "Goal 생성 주체.", "x-ownership": "AUTHORITATIVE"},
        "created_at": {"type": "string", "format": "date-time", "description": "Goal 생성 시각.", "x-ownership": "AUTHORITATIVE"},
        "updated_at": {"type": "string", "format": "date-time", "description": "Goal 정본이 마지막 수정된 시각.", "x-ownership": "AUTHORITATIVE"},
        "source": {
          "type": "string",
          "enum": ["conversation", "api", "inference", "decomposition", "import", "trigger", "system"],
          "description": "Goal의 생성 출처.",
          "x-ownership": "AUTHORITATIVE"
        },
        "origin_ref": {"type": ["string", "null"], "description": "생성 출처에 대한 참조.", "x-ownership": "REFERENCE"},
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/historyEntry"},
          "readOnly": true,
          "description": "Event/change log에서 구성하는 호환용 변경 이력 projection.",
          "x-ownership": "DERIVED"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["metric"],
      "properties": {
        "metric": {"type": "string", "description": "측정 대상 지표."},
        "operator": {"type": "string", "enum": [">=", "<=", ">", "<", "==", "!=", "between", "exists", "maximize", "minimize"], "description": "목표 달성 판정 연산자."},
        "target": {"type": ["number", "string", "array"], "description": "목표값."},
        "unit": {"type": "string", "description": "측정 단위."},
        "baseline": {"type": ["number", "string", "null"], "description": "Goal 시작 시점 값."}
      },
      "additionalProperties": false
    },
    "stakeholder": {
      "type": "object",
      "required": ["role", "name"],
      "properties": {
        "role": {"type": "string", "enum": ["Owner", "Sponsor", "Approver", "Contributor", "Affected"], "description": "Goal에 대한 역할."},
        "name": {"type": "string", "description": "주체 이름."},
        "type": {"type": "string", "enum": ["user", "organization", "agent", "system"], "description": "주체 종류."}
      },
      "additionalProperties": false
    },
    "dependencyRelation": {
      "type": "object",
      "required": ["goal_id", "relationship"],
      "properties": {
        "goal_id": {"type": "string", "description": "관계 대상 Goal ID."},
        "relationship": {"type": "string", "enum": ["DEPENDS_ON", "REQUIRES", "BLOCKS"], "description": "의존 관계 종류."},
        "weight": {"type": "number", "description": "관계 강도."}
      },
      "additionalProperties": false
    },
    "relatedRelation": {
      "type": "object",
      "required": ["goal_id", "relationship"],
      "properties": {
        "goal_id": {"type": "string", "description": "관계 대상 Goal ID."},
        "relationship": {"type": "string", "enum": ["ENABLES", "SUPPORTS", "CONFLICTS_WITH"], "description": "비의존 관계 종류."},
        "weight": {"type": "number", "description": "관계 강도."},
        "resolution": {"type": ["string", "null"], "description": "충돌 관계의 해소 상태/방법."}
      },
      "additionalProperties": false
    },
    "historyEntry": {
      "type": "object",
      "required": ["version", "changed_at", "changed_by", "change_type"],
      "properties": {
        "version": {"type": "integer", "minimum": 1, "description": "변경 후 버전."},
        "changed_at": {"type": "string", "format": "date-time", "description": "변경 시각."},
        "changed_by": {"type": "string", "description": "변경 주체."},
        "change_type": {"type": "string", "enum": ["created", "clarified", "field_updated", "status_changed", "priority_recalculated", "conflict_resolved", "merged", "split", "archived"], "description": "변경 종류."},
        "description": {"type": "string", "description": "변경 이유/내용."},
        "changes": {"type": "object", "description": "before/after 변경 데이터."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
