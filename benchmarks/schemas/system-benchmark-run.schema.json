{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-os.local/benchmarks/schemas/system-benchmark-run.schema.json",
  "title": "Intent OS System Routing Benchmark Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "run_id",
    "started_at",
    "finished_at",
    "case_suite_version",
    "router_version",
    "router_config_hash",
    "fixed_default_resource_id",
    "randomization_seed",
    "operator_expertise",
    "resource_pool_snapshot",
    "judge_configuration",
    "evaluation_cost_usd",
    "provenance",
    "trials"
  ],
  "properties": {
    "benchmark_id": {"const": "system-routing-v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "case_suite_version": {"type": "string", "minLength": 1},
    "router_version": {"type": "string", "minLength": 1},
    "router_config_hash": {"type": "string", "minLength": 1},
    "fixed_default_resource_id": {"type": "string", "minLength": 1},
    "randomization_seed": {"type": "integer", "minimum": 0},
    "operator_expertise": {"enum": ["novice", "intermediate", "expert"]},
    "resource_pool_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "kind", "provider", "version"],
        "properties": {
          "resource_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["model", "tool", "human", "service"]},
          "provider": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "pricing_snapshot": {"type": ["object", "null"], "additionalProperties": true},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "judge_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind", "judge_ids", "human_tiebreak_threshold"],
      "properties": {
        "blind": {"const": true},
        "judge_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "human_tiebreak_threshold": {"type": "number", "minimum": 0, "maximum": 100},
        "notes": {"type": "string"}
      }
    },
    "evaluation_cost_usd": {"type": "number", "minimum": 0},
    "provenance": {
      "type": "object",
      "description": "이 기록이 어떻게 만들어졌는지. 합성 실행과 실측을 구분하는 유일한 장치다. 이 필드가 없으면 두 기록은 형태가 같아 구별할 수 없다.",
      "additionalProperties": false,
      "required": ["evidence", "adapter_kinds", "human_measurements"],
      "properties": {
        "evidence": {
          "type": "boolean",
          "description": "벤치마크 근거로 인용 가능한가. 합성 어댑터가 하나라도 쓰였거나 사람 측정이 빠졌으면 false다."
        },
        "adapter_kinds": {
          "type": "array",
          "description": "이 실행에 쓰인 어댑터 종류. synthetic이 하나라도 있으면 evidence는 false여야 한다.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["live_api", "human", "synthetic"]}
        },
        "human_measurements": {
          "type": "object",
          "description": "사람에게서만 나오는 측정이 실제로 수집되었는가. §8 M2·M5·M6과 M1의 Judge에 대응한다.",
          "additionalProperties": false,
          "required": ["selection_time", "rework", "satisfaction", "quality_judges"],
          "properties": {
            "selection_time": {"type": "boolean", "description": "M2. Manual arm에서 실제 타이머로 측정했는가."},
            "rework": {"type": "boolean", "description": "M5. 사용자가 실제로 재작업을 요청/수락했는가."},
            "satisfaction": {"type": "boolean", "description": "M6. 사용자가 실제로 1~7을 입력했는가."},
            "quality_judges": {"type": "boolean", "description": "M1. 독립 Judge가 실제로 blind 채점했는가."}
          }
        },
        "notes": {"type": "string", "description": "evidence가 false인 이유 등 보충 설명."}
      }
    },
    "notes": {"type": "string"},
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "case_id",
          "repetition",
          "arm",
          "status",
          "selected_resource_ids",
          "selection_time_ms",
          "router_overhead_ms",
          "execution_latency_ms",
          "total_cost_usd",
          "rework_count",
          "internal_retry_count",
          "accepted",
          "excluded"
        ],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "pattern": "^[WRPSCT][0-9]{2}$"},
          "repetition": {"type": "integer", "minimum": 1},
          "arm": {"enum": ["manual", "fixed", "intent_os"]},
          "status": {
            "enum": [
              "completed",
              "timeout",
              "provider_error",
              "tool_error",
              "policy_block",
              "invalid_output",
              "budget_exceeded",
              "user_abandoned"
            ]
          },
          "selected_resource_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "decision_id": {"type": ["string", "null"]},
          "selection_time_ms": {"type": "number", "minimum": 0},
          "router_overhead_ms": {"type": "number", "minimum": 0},
          "execution_latency_ms": {"type": "number", "minimum": 0},
          "time_to_accepted_ms": {"type": ["number", "null"], "minimum": 0},
          "total_cost_usd": {"type": "number", "minimum": 0},
          "rework_count": {"type": "integer", "minimum": 0, "maximum": 2},
          "internal_retry_count": {"type": "integer", "minimum": 0},
          "quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "satisfaction_1_7": {"type": ["number", "null"], "minimum": 1, "maximum": 7},
          "accepted": {"type": "boolean"},
          "excluded": {"type": "boolean"},
          "excluded_reason": {"type": ["string", "null"]},
          "output_artifact_ref": {"type": ["string", "null"]},
          "freshness_snapshot_ref": {"type": ["string", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "title": "합성 어댑터가 쓰였으면 근거를 주장할 수 없다",
      "if": {
        "properties": {
          "provenance": {
            "properties": {"adapter_kinds": {"contains": {"const": "synthetic"}}},
            "required": ["adapter_kinds"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {"provenance": {"properties": {"evidence": {"const": false}}}}
      }
    },
    {
      "title": "사람 측정이 하나라도 빠지면 근거를 주장할 수 없다",
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "human_measurements": {
                "anyOf": [
                  {"properties": {"selection_time": {"const": false}}, "required": ["selection_time"]},
                  {"properties": {"rework": {"const": false}}, "required": ["rework"]},
                  {"properties": {"satisfaction": {"const": false}}, "required": ["satisfaction"]},
                  {"properties": {"quality_judges": {"const": false}}, "required": ["quality_judges"]}
                ]
              }
            },
            "required": ["human_measurements"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {"provenance": {"properties": {"evidence": {"const": false}}}}
      }
    }
  ]
}